#!/usr/bin/env python3
"""Run the repository's deterministic skill checks and unit tests."""

from __future__ import annotations

from pathlib import Path

from checks.run_unit_tests import run_unit_tests
from checks.validate_evals import validate_evals
from checks.validate_skills import validate_skills


REPO_ROOT = Path(__file__).resolve().parents[1]
SKILLS_ROOT = REPO_ROOT / "skills"


def main() -> int:
    skills, skill_errors = validate_skills(REPO_ROOT, SKILLS_ROOT)
    eval_errors, stats = validate_evals(REPO_ROOT, skills)
    errors = skill_errors + eval_errors

    print("==> Skill and eval definitions")
    for error in errors:
        print(f"ERROR {error}")
    if not errors:
        print(
            "OK "
            f"{len(skills)} skills, {stats['eval_files']} eval files, "
            f"{stats['workflow_cases']} workflow cases, {stats['trigger_cases']} trigger cases"
        )

    missing_workflows = stats["missing_workflow_evals"]
    if missing_workflows:
        print(f"INFO skills without workflow evals: {', '.join(missing_workflows)}")
    missing_triggers = stats["missing_trigger_evals"]
    if missing_triggers:
        print(f"INFO skills without trigger evals: {', '.join(missing_triggers)}")
    if stats["fixtureless_cases"]:
        print(f"INFO workflow cases without file fixtures: {stats['fixtureless_cases']}")
    model_cases = stats["workflow_cases"] + stats["trigger_cases"]
    if model_cases:
        print(f"INFO model-dependent cases validated but not executed: {model_cases}")

    print("\n==> Unit tests")
    tests_ok, tests_run, directories = run_unit_tests(REPO_ROOT)
    if tests_ok:
        print(f"OK {tests_run} tests from {directories} directories")

    return 0 if not errors and tests_ok else 1


if __name__ == "__main__":
    raise SystemExit(main())
