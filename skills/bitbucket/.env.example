# Bitbucket Cloud credentials for fetch_pr.py
#
# Copy this file to ".env" (in the skill directory or wherever you run the
# script from) and fill in your own values. The real ".env" is gitignored.
#
# Create an API token with scopes for Bitbucket at:
#   https://id.atlassian.com/manage-profile/security/api-tokens
# with these scopes: read:pullrequest:bitbucket and read:repository:bitbucket.
# Setup: https://support.atlassian.com/bitbucket-cloud/docs/create-an-api-token/
#
# BITBUCKET_EMAIL is your Atlassian account email used for HTTP Basic auth.
# Credentials are read only from this .env file (environment variables are not used).

BITBUCKET_EMAIL=your_atlassian_account_email
BITBUCKET_API_TOKEN=your_bitbucket_api_token
