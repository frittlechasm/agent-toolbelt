# Bitbucket Cloud credentials for fetch_pr.py
#
# Copy this file to ".env" (in the skill directory or wherever you run the
# script from) and fill in your own values. The real ".env" is gitignored.
#
# Create an app password at:
#   https://bitbucket.org/account/settings/app-passwords/
# with these scopes: "Pull requests: Read" and "Repositories: Read".
#
# Note: BITBUCKET_USERNAME is your Bitbucket username, NOT your email address.
# Credentials are read only from this .env file (environment variables are not used).

BITBUCKET_USERNAME=your_bitbucket_username
BITBUCKET_APP_PASSWORD=your_app_password
